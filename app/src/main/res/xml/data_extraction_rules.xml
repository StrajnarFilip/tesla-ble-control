<?xml version="1.0" encoding="utf-8"?>
<!-- The private key and session caches live in noBackupFilesDir, which Android never backs up:
     the key is wrapped by an Android Keystore key that can't move to another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
